{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local app window only: core defaults plus the app's own custom commands. No shell, filesystem, http or other plugin permissions (PLAN 6.9 rules 8/9; CSP stays default-src 'self').",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-profile-has-password",
    "allow-probe-connection",
    "allow-run-inventory",
    "allow-schema-diff",
    "allow-build-mapping",
    "allow-update-mapping",
    "allow-export-mapping",
    "allow-import-mapping",
    "allow-get-version"
  ]
}
